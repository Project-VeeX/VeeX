{
  "log": {
    "level": "info",
    "disabled": false
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct",
      "connect_timeout": "5s"
    },
    {
      "type": "trojan",
      "tag": "proxy",
      "server": "trojan.example.com",
      "server_port": 443,
      "password": "change-me",
      "connect_timeout": "5s",
      "tls": {
        "enabled": true,
        "server_name": "trojan.example.com",
        "disable_sni": false,
        "insecure": false,
        "handshake_timeout": "5s"
      },
      "multiplex": {
        "enabled": false
      }
    }
  ],
  "route": {
    "final": "proxy"
  }
}
