{
  "log": {
    "level": "info",
    "disabled": false,
    "timestamp": true
  },
  "dns": {
    "final": "primary",
    "disable_cache": false,
    "cache_capacity": 2048,
    "servers": [
      {
        "tag": "primary",
        "type": "udp",
        "server": "223.5.5.5",
        "server_port": 53,
        "detour": "direct"
      },
      {
        "tag": "backup",
        "type": "udp",
        "server": "1.1.1.1",
        "server_port": 53,
        "detour": "direct"
      }
    ],
    "rules": [
      {
        "domain": [
          "trojan.example.com"
        ],
        "server": "primary",
        "action": {
          "disable_cache": true
        }
      }
    ]
  },
  "inbounds": [
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "127.0.0.1",
      "listen_port": 15353,
      "network": "udp"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct",
      "connect_timeout": "5s"
    }
  ],
  "route": {
    "final": "direct",
    "rules": [
      {
        "inbound": [
          "dns-in"
        ],
        "action": "hijack-dns"
      }
    ]
  }
}
